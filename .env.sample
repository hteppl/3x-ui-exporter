# 3X-UI panel connection details (required)
PANEL_BASE_URL=https://your-panel-url
PANEL_USERNAME=your-panel-username
PANEL_PASSWORD=your-panel-password

# Skip SSL certificate verification (INSECURE)
INSECURE_SKIP_VERIFY=false

# General settings
UPDATE_INTERVAL=30
TIMEZONE=UTC

# Metrics server configuration
METRICS_IP=0.0.0.0
METRICS_PORT=9090

# Limit rows for clients up/down bytes (0=all; -1=disable; else top N rows)
CLIENTS_BYTES_ROWS=0

# BasicAuth protection for the metrics endpoint (recommended in production)
METRICS_PROTECTED=false
METRICS_USERNAME=metricsUser
METRICS_PASSWORD=MetricsVeryHardPassword
